# Supabase（Project Settings → API）
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# anon key（または publishable key "sb_publishable_..."）。ブラウザに出てよいキー
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service role key（または secret key "sb_secret_..."）。サーバー専用。NEXT_PUBLIC_ を付けないこと
SUPABASE_SERVICE_ROLE_KEY=

# Claude API（サーバー専用）。モデル ID はステップ2で最新を確認して設定
ANTHROPIC_API_KEY=
CLAUDE_MODEL_MAIN=
CLAUDE_MODEL_FAST=

# OpenAI（TTS / 文字起こし。サーバー専用）
OPENAI_API_KEY=
TTS_MODEL=
STT_MODEL=

# ドメイン制限（サーバー用と、ログインボタンの hd 指定用）
ALLOWED_EMAIL_DOMAIN=reiro.co.jp
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=reiro.co.jp

# 1ユーザー1日あたりの上限
DAILY_GENERATE_LIMIT=60
DAILY_SCORE_LIMIT=30
